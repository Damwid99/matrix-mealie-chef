# --- MATRIX CONFIGURATION ---
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@mealie-bot:example.com

# Provide EITHER password (bot logs in and caches token in DATA_DIR/session.json)
# OR an existing access token directly:
MATRIX_PASSWORD=
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=MEALIE_BOT

# Comma-separated list of Matrix user IDs allowed to interact with the bot
ALLOWED_USER_IDS=@you:example.com

# --- MEALIE CONFIGURATION ---
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=your_mealie_long_lived_token

# --- LLM CONFIGURATION (LiteLLM) ---
# Examples:
#   Gemini (free tier): gemini/gemini-2.5-flash
#   OpenAI:             openai/gpt-4o-mini
#   Anthropic:          anthropic/claude-3-5-haiku-latest
#   Ollama (local):     ollama/llama3.1
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=your_api_key
# Optional: custom base URL (e.g. http://ollama:11434 or OpenRouter)
LLM_API_BASE=

# --- RUNTIME SETTINGS ---
DATA_DIR=./data
DRAFT_TTL_SECONDS=7200
LOG_LEVEL=INFO
LOG_JSON=false